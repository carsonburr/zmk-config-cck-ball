#define ZMK_POINTING_DEFAULT_MOVE_VAL 1000
#define ZMK_POINTING_DEFAULT_SCRL_VAL 200

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/input_transform.h>

&soft_off { hold-time-ms = <2000>; };

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <0>;
    time-to-max-speed-ms = <300>;
    delay-ms = <0>;
};

&mmv {
    acceleration-exponent = <1>;
    time-to-max-speed-ms = <500>;
    trigger-period-ms = <16>;
};

#define MY_COMBO(NAME, LAYERS, KEYS, BINDING) \
  combo_##NAME {                              \
    timeout-ms = <50>;                        \
    layers = <LAYERS>;                        \
    key-positions = <KEYS>;                   \
    bindings = <&kp BINDING>;                 \
  };

/ {
    combos {
        compatible = "zmk,combos";
        MY_COMBO(lpar, 0, 31 32, LPAR)
        MY_COMBO(rpar, 0, 32 33, RPAR)
        MY_COMBO(lt  , 1, 31 32, LPAR)
        MY_COMBO(gt  , 1, 32 33, RPAR)
        MY_COMBO(lbrc, 0, 43 44, LBRC)
        MY_COMBO(rbrc, 0, 43 44, RBRC)
        MY_COMBO(lbrk, 1, 43 44, LBRK)
        MY_COMBO(rbrk, 1, 43 44, RBRK)
        MY_COMBO(eq  , 0, 26 27, EQUAL)
        MY_COMBO(esc , 0, 27 28, ESC)
    };

    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <0>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        QWERTY {
            display-name = "QWERTY";
            bindings = <
&kp C_PP   &kp N1    &kp N2  &kp N3     &kp N4          &kp N5       &kp N6     &kp N7     &kp N8     &kp N9   &kp N0   &kp DELETE
&kp ESC    &kp Q     &kp W   &kp E      &kp R           &kp T        &kp Y      &kp U      &kp I      &kp O    &kp P    &kp EQUAL
&kp LCTRL  &kp A     &kp S   &kp D      &kp F           &kp G        &kp H      &kp J      &kp K      &kp L    &kp SEMI &kp SQT
&kp LALT   &kp Z     &kp X   &kp C      &kp V           &kp B        &kp N      &kp M      &kp COMMA  &kp DOT  &kp FSLH &kp END
&none      &kp LGUI  &none   &lt 1 RET  &mt LSHFT BSPC  &lt 2 TAB    &kp UNDER  &kp SPACE  &kp MINUS  &none    &none    &tog 4
            >;

            sensor-bindings = <&inc_dec_kp PG_UP PG_DN &inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        Nav_layer {
            display-name = "Nav layer";
            bindings = <
&kp F12    &kp F1        &kp F2       &kp F3       &kp F4        &kp F5  &kp F6       &kp F7       &kp F8       &kp F9    &kp F10  &kp F11
&trans     &kp LG(Q)     &kp N7       &kp N8       &kp N9        &trans  &trans       &kp INSERT   &kp DELETE   &trans    &trans   &trans
&kp LCTRL  &hm LCTRL N0  &hm LALT N4  &hm LGUI N5  &hm LSHFT N6  &trans  &kp LEFT     &kp DOWN     &kp UP       &kp RIGHT &kp PIPE &kp TILDE
&kp LALT   &kp LGUI      &kp N1       &kp N2       &kp N3        &trans  &kp HOME     &kp END      &trans       &trans    &kp BSLH &kp GRAVE
&trans     &trans        &trans       &trans       &trans        &trans  &lt 3 UNDER  &kp SPACE    &kp MINUS    &trans    &trans   &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        Mouse_layer {
            display-name = "Mouse layer";
            bindings = <
&trans    &trans &trans &trans &trans      &trans   &trans &trans         &trans         &trans          &trans       &trans
&trans    &trans &trans &trans &trans      &trans   &trans &trans         &mmv MOVE_UP   &trans          &trans       &trans
&kp LCTRL &trans &trans &trans &kp LS(TAB) &trans   &trans &mmv MOVE_LEFT &mmv MOVE_DOWN &mmv MOVE_RIGHT &msc SCRL_UP &trans
&kp LALT  &trans &trans &trans &trans      &trans   &trans &msc SCRL_DOWN &trans         &trans          &trans       &trans
&trans    &trans &trans &trans &trans      &trans   &trans &mkp LCLK      &mkp RCLK      &trans          &trans       &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        BT_layers {
            display-name = "Bluetooth";
            bindings = <
&trans     &bt BT_SEL 0    &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &trans      &trans  &trans  &trans  &trans  &trans
&trans     &trans          &trans        &trans        &trans        &trans        &trans      &trans  &trans  &trans  &trans  &trans
&kp LCTRL  &bt BT_CLR_ALL  &trans        &trans        &kp LS(TAB)   &trans        &trans      &trans  &trans  &trans  &trans  &trans
&kp LALT   &trans          &trans        &bt BT_CLR    &trans        &trans        &bt BT_NXT  &trans  &trans  &trans  &trans  &trans
&trans     &trans          &trans        &trans        &trans        &trans        &trans      &trans  &trans  &trans  &trans  &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        Gaming_layer {
            display-name = "Gaming layer";
            bindings = <
&kp C_PP         &kp N1        &kp N2        &kp N3          &kp N4     &kp N5        &kp N6    &kp N7    &kp N8     &kp N9          &kp N0          &kp BACKSPACE
&kp ESC          &kp Q         &kp W         &kp E           &kp R      &kp T         &kp Y     &kp U     &kp I      &kp O           &kp P           &kp BSLH
&kp LSHFT        &kp A         &kp S         &kp D           &kp F      &kp G         &kp H     &kp J     &kp K      &kp L           &kp SEMI        &kp SQT
&kp LCTRL        &kp Z         &kp X         &kp C           &kp V      &kp B         &kp N     &kp M     &kp COMMA  &kp DOT         &kp FSLH        &kp RET
&none            &none         &none         &kp SPACE       &kp TAB    &kp M         &mkp LCLK &mkp RCLK &kp SPACE  &tog 4          &none           &none
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };
    };
};
